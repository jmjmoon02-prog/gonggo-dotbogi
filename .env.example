# 이 파일을 복사해 app/.env 로 저장한 뒤 값을 직접 넣으세요. (.env 는 Git 에 올라가지 않습니다)
# 값은 채팅·코드·캡처 화면에 붙여넣지 마세요.

# OpenAI API 키 (3단계)
OPENAI_API_KEY=
# 모델 교체 시에만 (기본 gpt-6.2-sol)
MODEL_ID=

# 공공데이터포털(data.go.kr) 인증키 (4단계, Encoding/Decoding 중 어느 것을 넣을지는 4단계에서 안내)
DATA_GO_KR_SERVICE_KEY=

# Hugging Face 토큰(비공개 Dataset 쓰기 권한만) + Dataset 이름 (5단계)
HF_TOKEN=
HF_DATASET_REPO=

# 호출 상한 (비우면 기본값)
SESSION_CALL_LIMIT=
DAILY_CALL_LIMIT=
