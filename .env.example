# 이 파일을 복사해 app/.env 로 저장한 뒤 값을 직접 넣으세요. (.env 는 Git 에 올라가지 않습니다)
# 값은 채팅·코드·캡처 화면에 붙여넣지 마세요.

# OpenAI API 키 (3단계)
OPENAI_API_KEY=
# 모델 교체 시에만 (기본 gpt-6.2-sol)
MODEL_ID=

# 공공데이터포털(data.go.kr) 일반 인증키 — 국세청 사업자 상태조회·국민연금 가입 사업장 (Encoding/Decoding 어느 쪽도 됨)
DATA_GO_KR_SERVICE_KEY=
# [확장 기능, 이번 MVP 제외] 고용24(work24.go.kr) OPEN-API 인증키 — 워크넷 공식 공고 대조. 기업회원 전용·심사 후 발급. 없으면 이 확인만 생략
WORK24_AUTH_KEY=

# Hugging Face 토큰(비공개 Dataset 쓰기 권한만) + Dataset 이름 (5단계)
HF_TOKEN=
HF_DATASET_REPO=

# 호출 상한 (비우면 기본값)
SESSION_CALL_LIMIT=
DAILY_CALL_LIMIT=
